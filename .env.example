# 账号与密码（必填）
PORTAL_ACCOUNT=your_account
PORTAL_PASSWORD=your_password

# 门户登录地址（逗号分隔，可写多个候选）
PORTAL_LOGIN_CANDIDATES=http://portal.example.com/login,http://portal.example.com

# 可选：自定义工作目录（默认脚本所在目录）
# AUTO_WIFI_PROJ=E:\Projects\Auto_Wifi_Connect_Win

# 可选：自定义 .env 路径（用于调试），默认 $AUTO_WIFI_PROJ\.env
# AUTO_WIFI_ENV=E:\Projects\Auto_Wifi_Connect_Win\.env
# 账号与密码（必填，建议用单引号包裹防止特殊字符被展开）
PORTAL_ACCOUNT='your_account'
PORTAL_PASSWORD='your_password'   # 含 $ 时务必用单引号或转义，如 'p@ss$word'

# 门户登录地址（逗号分隔，可写多个候选）
PORTAL_LOGIN_CANDIDATES='http://portal.example.com/,http://portal.example.com/login'

# 可选：自定义工作目录（默认脚本所在目录）
# AUTO_WIFI_PROJ='C:\Users\you\AutoWiFi'

# 可选：自定义 .env 路径（用于调试），默认 $AUTO_WIFI_PROJ\.env
# AUTO_WIFI_ENV='C:\Users\you\AutoWiFi\.env'
